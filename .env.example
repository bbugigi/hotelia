# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotelia?schema=public"

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ──────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ──────────────────────────────────────────────
# Stripe
# ──────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_TERMINAL_SECRET_KEY="rtk_test_..."

# ──────────────────────────────────────────────
# Twilio (SMS)
# ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1..."

# ──────────────────────────────────────────────
# WhatsApp (Meta Cloud API)
# ──────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN="..."
WHATSAPP_PHONE_NUMBER_ID="..."
WHATSAPP_VERIFY_TOKEN="..."

# ──────────────────────────────────────────────
# Email (Resend)
# ──────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@hotelia.com"

# ──────────────────────────────────────────────
# AI (OpenAI)
# ──────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ──────────────────────────────────────────────
# Object Storage (Cloudflare R2 or S3)
# ──────────────────────────────────────────────
S3_BUCKET="hotelia-uploads"
S3_ENDPOINT="https://..."
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."
S3_REGION="auto"

# ──────────────────────────────────────────────
# Sentry
# ──────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ──────────────────────────────────────────────
# App URLs
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GUEST_URL="http://localhost:3001"
NEXT_PUBLIC_KDS_URL="http://localhost:3002"
