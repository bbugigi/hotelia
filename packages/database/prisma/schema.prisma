// Hotelia — Prisma Schema
// Unified data core for PMS, RMS, POS, CRM, Work Orders, Messaging

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum RoomStatus {
  VACANT_DIRTY
  VACANT_CLEAN
  VACANT_INSPECTED
  OCCUPIED_DIRTY
  OCCUPIED_CLEAN
  OUT_OF_ORDER
  OUT_OF_SERVICE
}

enum RoomType {
  STANDARD
  SUPERIOR
  DELUXE
  SUITE
  PENTHOUSE
  VILLA
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum ReservationSource {
  DIRECT
  BOOKING_COM
  EXPEDIA
  AIRBNB
  PHONE
  WALK_IN
}

enum FolioStatus {
  OPEN
  CLOSED
  DISPUTED
  WRITTEN_OFF
}

enum LineItemSource {
  ROOM
  POS_FOOD
  POS_BEVERAGE
  POS_RETAIL
  MINIBAR
  SPA
  LAUNDRY
  PARKING
  TAX
  DISCOUNT
  ADJUSTMENT
  PAYMENT
  REFUND
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT
  CASH
  APPLE_PAY
  GOOGLE_PAY
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  REFUNDED
  FAILED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderChannel {
  QR_IN_ROOM
  POS_TERMINAL
  WEB_GUEST
  PHONE
  STAFF
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkOrderStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum WorkOrderCategory {
  MAINTENANCE
  HOUSEKEEPING
  GUEST_REQUEST
  INSPECTION
  EMERGENCY
}

enum MessageChannel {
  SMS
  WHATSAPP
  WEB_CHAT
  EMAIL
  IN_APP
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSenderType {
  GUEST
  STAFF
  AI_AGENT
  SYSTEM
}

enum ConversationStatus {
  OPEN
  ASSIGNED
  RESOLVED
  ARCHIVED
}

enum StaffRole {
  OWNER
  GENERAL_MANAGER
  FRONT_DESK
  HOUSEKEEPING_SUPERVISOR
  HOUSEKEEPER
  MAINTENANCE
  FOOD_BEVERAGE
  POS_STAFF
  READONLY
}

enum ShiftStatus {
  SCHEDULED
  CHECKED_IN
  CHECKED_OUT
  ABSENT
}

// ──────────────────────────────────────────────
// Properties & Rooms
// ──────────────────────────────────────────────

model Property {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(255)
  slug       String   @unique @db.VarChar(100)
  address1   String?  @map("address_line1") @db.VarChar(255)
  address2   String?  @map("address_line2") @db.VarChar(255)
  city       String?  @db.VarChar(100)
  stateProv  String?  @map("state") @db.VarChar(100)
  country    String   @db.VarChar(3)
  postalCode String?  @map("postal_code") @db.VarChar(20)
  timezone   String   @db.VarChar(50)
  currency   String   @db.VarChar(3)
  phone      String?  @db.VarChar(20)
  email      String?  @db.VarChar(255)
  config     Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  rooms                Room[]
  guests               Guest[]
  reservations         Reservation[]
  folios               Folio[]
  payments             Payment[]
  ratePlans            RatePlan[]
  dailyRates           DailyRate[]
  channelInventory     ChannelInventory[]
  workOrders           WorkOrder[]
  posOrders            PosOrder[]
  menuItems            MenuItem[]
  conversations        Conversation[]
  guestStays           GuestStay[]
  staffUsers           StaffUser[]
  staffShifts          StaffShift[]
  maintenanceSchedules MaintenanceSchedule[]

  @@index([slug])
  @@map("properties")
}

model Room {
  id           String     @id @default(uuid()) @db.Uuid
  propertyId   String     @map("property_id") @db.Uuid
  number       String     @db.VarChar(10)
  floor        Int?
  type         RoomType
  status       RoomStatus @default(VACANT_DIRTY)
  baseRate     Decimal?   @map("base_rate") @db.Decimal(10, 2)
  maxOccupancy Int        @default(2) @map("max_occupancy")
  bedConfig    String?    @map("bed_config") @db.VarChar(50)
  amenities    String[]
  lockProtocol String?    @map("lock_protocol")
  lockDeviceId String?    @map("lock_device_id")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  property     Property        @relation(fields: [propertyId], references: [id])
  reservations Reservation[]
  statusLogs   RoomStatusLog[]
  orderHistory PosOrder[]

  @@unique([propertyId, number])
  @@index([propertyId, status])
  @@index([propertyId, type])
  @@map("rooms")
}

// ──────────────────────────────────────────────
// Guests & CRM
// ──────────────────────────────────────────────

model Guest {
  id             String    @id @default(uuid()) @db.Uuid
  propertyId     String    @map("property_id") @db.Uuid
  firstName      String    @map("first_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(30)
  phoneCountry   String?   @map("phone_country") @db.VarChar(3)
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  nationality    String?   @db.VarChar(3)
  gender         String?   @db.VarChar(20)
  idDocumentType String?   @map("id_document_type")
  idDocumentUrl  String?   @map("id_document_url")
  dietaryPrefs   String[]  @default([]) @map("dietary_prefs")
  accessibility  String[]  @default([])
  languagePref   String    @default("en") @map("language_pref")
  notes          String?
  tags           String[]  @default([])
  lifetimeSpend  Decimal   @default(0) @map("lifetime_spend") @db.Decimal(12, 2)
  stayCount      Int       @default(0) @map("stay_count")
  avatarUrl      String?   @map("avatar_url")
  consentPii     Boolean   @default(false) @map("consent_pii")
  consentPiiAt   DateTime? @map("consent_pii_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  property      Property       @relation(fields: [propertyId], references: [id])
  stays         GuestStay[]
  reservations  Reservation[]
  folios        Folio[]
  conversations Conversation[]
  orders        PosOrder[]

  @@index([propertyId, email])
  @@index([propertyId, phone])
  @@index([propertyId])
  @@map("guests")
}

model GuestStay {
  id           String    @id @default(uuid()) @db.Uuid
  guestId      String    @map("guest_id") @db.Uuid
  propertyId   String    @map("property_id") @db.Uuid
  checkIn      DateTime? @map("check_in")
  checkOut     DateTime? @map("check_out")
  roomType     RoomType? @map("room_type")
  roomNumber   String?   @map("room_number")
  nights       Int?
  spendTotal   Decimal?  @map("spend_total") @db.Decimal(12, 2)
  satisfaction Int?
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  guest    Guest    @relation(fields: [guestId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@index([guestId])
  @@index([propertyId])
  @@map("guest_stays")
}

// ──────────────────────────────────────────────
// Reservations & Folio
// ──────────────────────────────────────────────

model Reservation {
  id                 String            @id @default(uuid()) @db.Uuid
  propertyId         String            @map("property_id") @db.Uuid
  guestId            String            @map("guest_id") @db.Uuid
  roomId             String?           @map("room_id") @db.Uuid
  confirmationNo     String            @unique @map("confirmation_no") @db.VarChar(20)
  source             ReservationSource
  status             ReservationStatus @default(PENDING)
  checkInDate        DateTime          @map("check_in_date") @db.Date
  checkOutDate       DateTime          @map("check_out_date") @db.Date
  adults             Int               @default(1)
  children           Int               @default(0)
  roomType           RoomType          @map("room_type")
  ratePlan           String?           @map("rate_plan") @db.VarChar(100)
  nightlyRate        Decimal           @map("nightly_rate") @db.Decimal(10, 2)
  totalAmount        Decimal           @map("total_amount") @db.Decimal(12, 2)
  depositPaid        Decimal           @default(0) @map("deposit_paid") @db.Decimal(10, 2)
  currency           String            @db.VarChar(3)
  specialRequests    String?           @map("special_requests")
  isVip              Boolean           @default(false) @map("is_vip")
  assignedRoomId     String?           @map("assigned_room") @db.Uuid
  checkedInAt        DateTime?         @map("checked_in_at")
  checkedOutAt       DateTime?         @map("checked_out_at")
  cancelledAt        DateTime?         @map("cancelled_at")
  cancellationReason String?           @map("cancellation_reason")
  otaReservationId   String?           @map("ota_reservation_id")
  channelMetadata    Json              @default("{}") @map("channel_metadata")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id])
  guest    Guest    @relation(fields: [guestId], references: [id])
  room     Room?    @relation(fields: [roomId], references: [id])
  folios   Folio[]

  @@index([propertyId, checkInDate, checkOutDate])
  @@index([propertyId, status])
  @@index([guestId])
  @@map("reservations")
}

model Folio {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @map("reservation_id") @db.Uuid
  guestId       String      @map("guest_id") @db.Uuid
  propertyId    String      @map("property_id") @db.Uuid
  status        FolioStatus @default(OPEN)
  currency      String      @db.VarChar(3)
  balance       Decimal     @default(0) @db.Decimal(12, 2)
  postedAt      DateTime?   @map("posted_at")
  closedAt      DateTime?   @map("closed_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  reservation Reservation     @relation(fields: [reservationId], references: [id])
  guest       Guest           @relation(fields: [guestId], references: [id])
  property    Property        @relation(fields: [propertyId], references: [id])
  lineItems   FolioLineItem[]
  payments    Payment[]

  @@index([reservationId])
  @@index([propertyId])
  @@map("folios")
}

model FolioLineItem {
  id             String         @id @default(uuid()) @db.Uuid
  folioId        String         @map("folio_id") @db.Uuid
  sourceModule   LineItemSource @map("source_module")
  description    String         @db.VarChar(500)
  quantity       Decimal        @default(1) @db.Decimal(8, 2)
  unitPrice      Decimal        @map("unit_price") @db.Decimal(10, 2)
  taxRate        Decimal        @default(0) @map("tax_rate") @db.Decimal(5, 4)
  taxAmount      Decimal        @default(0) @map("tax_amount") @db.Decimal(10, 2)
  discountAmount Decimal        @default(0) @map("discount_amount") @db.Decimal(10, 2)
  total          Decimal        @db.Decimal(10, 2)
  metadata       Json           @default("{}")
  postedBy       String?        @map("posted_by") @db.Uuid
  postedAt       DateTime       @default(now()) @map("posted_at")
  voided         Boolean        @default(false)
  voidedAt       DateTime?      @map("voided_at")
  voidedBy       String?        @map("voided_by") @db.Uuid

  folio Folio @relation(fields: [folioId], references: [id])

  @@index([folioId])
  @@index([sourceModule])
  @@map("folio_line_items")
}

// ──────────────────────────────────────────────
// Payments
// ──────────────────────────────────────────────

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  folioId         String        @map("folio_id") @db.Uuid
  propertyId      String        @map("property_id") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @db.VarChar(3)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?       @map("stripe_payment_id")
  stripeChargeId  String?       @map("stripe_charge_id")
  lastFour        String?       @map("last_four") @db.VarChar(4)
  cardBrand       String?       @map("card_brand") @db.VarChar(20)
  preAuth         Boolean       @default(false) @map("pre_auth")
  capturedAt      DateTime?     @map("captured_at")
  refundedAmount  Decimal       @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  metadata        Json          @default("{}")
  createdAt       DateTime      @default(now()) @map("created_at")

  folio    Folio    @relation(fields: [folioId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@index([folioId])
  @@index([propertyId])
  @@map("payments")
}

// ──────────────────────────────────────────────
// Revenue Management
// ──────────────────────────────────────────────

model RatePlan {
  id                 String   @id @default(uuid()) @db.Uuid
  propertyId         String   @map("property_id") @db.Uuid
  name               String   @db.VarChar(200)
  roomType           RoomType @map("room_type")
  baseRate           Decimal  @map("base_rate") @db.Decimal(10, 2)
  isActive           Boolean  @default(true) @map("is_active")
  includesBreakfast  Boolean  @default(false) @map("includes_breakfast")
  cancellationPolicy String?  @map("cancellation_policy") @db.VarChar(50)
  minStay            Int?     @map("min_stay")
  maxStay            Int?     @map("max_stay")
  createdAt          DateTime @default(now()) @map("created_at")

  property   Property    @relation(fields: [propertyId], references: [id])
  dailyRates DailyRate[]

  @@index([propertyId])
  @@map("rate_plans")
}

model DailyRate {
  id             String   @id @default(uuid()) @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  ratePlanId     String   @map("rate_plan_id") @db.Uuid
  date           DateTime @db.Date
  rate           Decimal  @db.Decimal(10, 2)
  availableRooms Int      @map("available_rooms")
  occupancyPct   Decimal? @map("occupancy_pct") @db.Decimal(5, 2)
  demandFactor   Decimal  @default(1) @map("demand_factor") @db.Decimal(4, 3)
  minRate        Decimal? @map("min_rate") @db.Decimal(10, 2)
  maxRate        Decimal? @map("max_rate") @db.Decimal(10, 2)
  isClosed       Boolean  @default(false) @map("is_closed")
  source         String   @default("system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id])
  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id])

  @@unique([ratePlanId, date])
  @@index([propertyId, date])
  @@map("daily_rates")
}

model ChannelInventory {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  roomType     RoomType @map("room_type")
  channel      String   @db.VarChar(50)
  date         DateTime @db.Date
  available    Int
  rate         Decimal? @db.Decimal(10, 2)
  closed       Boolean  @default(false)
  lastSyncedAt DateTime @default(now()) @map("last_synced_at")
  syncStatus   String   @default("synced") @map("sync_status")

  property Property @relation(fields: [propertyId], references: [id])

  @@unique([propertyId, roomType, channel, date])
  @@index([syncStatus])
  @@map("channel_inventory")
}

// ──────────────────────────────────────────────
// Housekeeping & Work Orders
// ──────────────────────────────────────────────

model RoomStatusLog {
  id             String      @id @default(uuid()) @db.Uuid
  roomId         String      @map("room_id") @db.Uuid
  previousStatus RoomStatus? @map("previous_status")
  newStatus      RoomStatus  @map("new_status")
  changedBy      String?     @map("changed_by") @db.Uuid
  source         String      @default("housekeeping")
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id])

  @@index([roomId, createdAt])
  @@map("room_status_log")
}

model WorkOrder {
  id              String            @id @default(uuid()) @db.Uuid
  propertyId      String            @map("property_id") @db.Uuid
  roomId          String?           @map("room_id") @db.Uuid
  category        WorkOrderCategory
  priority        WorkOrderPriority @default(MEDIUM)
  status          WorkOrderStatus   @default(PENDING)
  title           String            @db.VarChar(300)
  description     String?
  assignedTo      String?           @map("assigned_to") @db.Uuid
  createdBy       String            @map("created_by") @db.Uuid
  slaDeadline     DateTime?         @map("sla_deadline")
  startedAt       DateTime?         @map("started_at")
  completedAt     DateTime?         @map("completed_at")
  resolutionNotes String?           @map("resolution_notes")
  attachments     String[]          @default([])
  isRecurring     Boolean           @default(false) @map("is_recurring")
  recurrenceRule  String?           @map("recurrence_rule") @db.VarChar(100)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId, status])
  @@index([assignedTo])
  @@map("work_orders")
}

// ──────────────────────────────────────────────
// POS & Orders
// ──────────────────────────────────────────────

model PosOrder {
  id              String       @id @default(uuid()) @db.Uuid
  propertyId      String       @map("property_id") @db.Uuid
  folioId         String?      @map("folio_id") @db.Uuid
  guestId         String?      @map("guest_id") @db.Uuid
  roomId          String?      @map("room_id") @db.Uuid
  channel         OrderChannel
  status          OrderStatus  @default(PLACED)
  subtotal        Decimal      @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal      @default(0) @map("tax_amount") @db.Decimal(10, 2)
  discountAmount  Decimal      @default(0) @map("discount_amount") @db.Decimal(10, 2)
  total           Decimal      @default(0) @db.Decimal(10, 2)
  paymentMethod   String?      @map("payment_method")
  paymentStatus   String?      @default("pending") @map("payment_status")
  stripePaymentId String?      @map("stripe_payment_id")
  notes           String?
  placedAt        DateTime     @default(now()) @map("placed_at")
  confirmedAt     DateTime?    @map("confirmed_at")
  deliveredAt     DateTime?    @map("delivered_at")
  completedAt     DateTime?    @map("completed_at")

  property Property       @relation(fields: [propertyId], references: [id])
  room     Room?          @relation(fields: [roomId], references: [id])
  guest    Guest?         @relation(fields: [guestId], references: [id])
  items    PosOrderItem[]

  @@index([propertyId, status])
  @@map("pos_orders")
}

model PosOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  orderId         String  @map("order_id") @db.Uuid
  menuItemId      String  @map("menu_item_id") @db.Uuid
  quantity        Int     @default(1)
  unitPrice       Decimal @map("unit_price") @db.Decimal(10, 2)
  modifiers       Json    @default("[]")
  specialRequests String? @map("special_requests")
  status          String  @default("pending")

  order PosOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("pos_order_items")
}

model MenuItem {
  id              String   @id @default(uuid()) @db.Uuid
  propertyId      String   @map("property_id") @db.Uuid
  category        String   @db.VarChar(100)
  name            String   @db.VarChar(200)
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  taxRate         Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 4)
  imageUrl        String?  @map("image_url")
  isAvailable     Boolean  @default(true) @map("is_available")
  preparationTime Int?     @map("preparation_time")
  allergens       String[] @default([])
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId, category])
  @@map("menu_items")
}

// ──────────────────────────────────────────────
// Messaging
// ──────────────────────────────────────────────

model Conversation {
  id            String             @id @default(uuid()) @db.Uuid
  propertyId    String             @map("property_id") @db.Uuid
  guestId       String?            @map("guest_id") @db.Uuid
  channel       MessageChannel
  status        ConversationStatus @default(OPEN)
  assignedTo    String?            @map("assigned_to") @db.Uuid
  lastMessageAt DateTime           @default(now()) @map("last_message_at")
  createdAt     DateTime           @default(now()) @map("created_at")

  property Property  @relation(fields: [propertyId], references: [id])
  guest    Guest?    @relation(fields: [guestId], references: [id])
  messages Message[]

  @@index([propertyId, status])
  @@map("conversations")
}

model Message {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  senderType     MessageSenderType @map("sender_type")
  senderId       String?           @map("sender_id") @db.Uuid
  direction      MessageDirection
  content        String            @db.Text
  contentType    String            @default("text") @map("content_type")
  mediaUrl       String?           @map("media_url")
  readAt         DateTime?         @map("read_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ──────────────────────────────────────────────
// Staff & RBAC
// ──────────────────────────────────────────────

model StaffUser {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @map("property_id") @db.Uuid
  email       String    @unique @db.VarChar(255)
  phone       String?   @db.VarChar(30)
  firstName   String    @map("first_name") @db.VarChar(100)
  lastName    String    @map("last_name") @db.VarChar(100)
  role        StaffRole
  pinHash     String?   @map("pin_hash")
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  property Property     @relation(fields: [propertyId], references: [id])
  shifts   StaffShift[]

  @@index([propertyId, email])
  @@map("staff_users")
}

model StaffShift {
  id           String      @id @default(uuid()) @db.Uuid
  staffUserId  String      @map("staff_user_id") @db.Uuid
  propertyId   String      @map("property_id") @db.Uuid
  shiftDate    DateTime    @map("shift_date") @db.Date
  startTime    DateTime    @map("start_time")
  endTime      DateTime    @map("end_time")
  roleOverride StaffRole?  @map("role_override")
  status       ShiftStatus @default(SCHEDULED)
  createdAt    DateTime    @default(now()) @map("created_at")

  staff    StaffUser @relation(fields: [staffUserId], references: [id])
  property Property  @relation(fields: [propertyId], references: [id])

  @@index([propertyId, shiftDate])
  @@map("staff_shifts")
}

// ──────────────────────────────────────────────
// Maintenance
// ──────────────────────────────────────────────

model MaintenanceSchedule {
  id            String     @id @default(uuid()) @db.Uuid
  propertyId    String     @map("property_id") @db.Uuid
  assetType     String     @map("asset_type") @db.VarChar(100)
  assetLocation String?    @map("asset_location") @db.VarChar(200)
  frequency     String     @db.VarChar(50)
  lastCompleted DateTime?  @map("last_completed")
  nextDue       DateTime   @map("next_due")
  assignedRole  StaffRole? @map("assigned_role")
  template      Json
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId, nextDue])
  @@map("maintenance_schedules")
}

// ──────────────────────────────────────────────
// Audit
// ──────────────────────────────────────────────

model AuditLog {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  propertyId String   @map("property_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.Uuid
  oldValue   Json?
  newValue   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([propertyId, createdAt])
  @@map("audit_log")
}
